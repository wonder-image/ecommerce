{
    "name": "Wonder Ecommerce",
    "slug": "ecommerce",
    "version": "0.2.0-beta.1",
    "description": "Negozio online del gestionale: vetrina, carrello, checkout e account dei clienti.",
    "namespace": "Wonder\\Plugin\\Ecommerce\\",
    "entrypoint": "Wonder\\Plugin\\Ecommerce\\Ecommerce",
    "author": {
        "name": "Wonder Image",
        "email": "info@wonderimage.it"
    },
    "frameworkCompatibility": {
        "wonder-app": "^2.4.0-beta.2",
        "php": "^8.2"
    },
    "dependencies": {
        "modules": [
            "customer-account",
            "gestionale"
        ]
    },
    "paths": {
        "src": "src",
        "handlers": "http",
        "views": "view",
        "assets": "resources/assets",
        "lang": "lang",
        "tests": "tests"
    },
    "routes": {
        "frontend": "config/routes/route.frontend.php",
        "backend": "config/routes/route.backend.php",
        "api": "config/routes/route.api.php"
    },
    "seo": {
        "robotsDisallow": ["/carrello/", "/checkout/", "/account/"],
        "sitemaps": ["/shared/sitemap/catalogo.xml"]
    },
    "permissions": {
        "definitions": "config/permissions.php"
    },
    "views": {
        "sealed": [
            "pages/cart",
            "pages/checkout",
            "pages/account",
            "components/checkout"
        ]
    }
}
