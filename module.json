{
    "name": "Wonder Ecommerce",
    "slug": "ecommerce",
    "version": "0.1.0",
    "description": "Negozio online del gestionale: vetrina, carrello, checkout e account dei clienti.",
    "namespace": "Wonder\\Plugin\\Ecommerce\\",
    "entrypoint": "Wonder\\Plugin\\Ecommerce\\Ecommerce",
    "author": {
        "name": "Wonder Image",
        "email": "info@wonderimage.it"
    },
    "frameworkCompatibility": {
        "wonder-app": "^2.4.0-beta.1",
        "php": "^8.2"
    },
    "dependencies": {
        "modules": [
            "gestionale"
        ]
    },
    "paths": {
        "src": "src",
        "handlers": "http",
        "views": "view",
        "assets": "resources/assets",
        "lang": "lang",
        "tests": "tests"
    },
    "routes": {
        "frontend": "config/routes/route.frontend.php",
        "backend": "config/routes/route.backend.php"
    },
    "permissions": {
        "definitions": "config/permissions.php"
    },
    "views": {
        "sealed": [
            "pages/cart",
            "pages/checkout",
            "pages/account",
            "pages/auth"
        ]
    }
}
